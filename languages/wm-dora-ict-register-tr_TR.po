#. Plugin Name of the plugin
#: wm-dora-ict-register.php
msgid "WM DORA ICT Register & Supplier Portal"
msgstr "WM DORA BİT Kaydı ve Tedarikçi Portalı"

#. Plugin URI of the plugin
#: wm-dora-ict-register.php
msgid "https://arnoldwender.com/wordpress-plugins/wm-dora-ict-register/"
msgstr "https://arnoldwender.com/wordpress-plugins/wm-dora-ict-register/"

#. Description of the plugin
#: wm-dora-ict-register.php
msgid ""
"List of ICT third-party service providers and contracts with validated LEI, "
"a CIF marking and a CSV export of the plugin tables. Not the register "
"templates of Implementing Regulation (EU) 2024/2956 and not an xBRL-CSV "
"report."
msgstr ""
"Doğrulanmış LEI, CIF işaretlemesi ve eklenti tablolarının CSV dışa aktarımı "
"ile üçüncü taraf BİT hizmet sağlayıcıları ve sözleşmeler listesi. (AB) "
"2024/2956 sayılı Uygulama Tüzüğü kayıt şablonlarını veya xBRL-CSV raporunu "
"üretmez."

