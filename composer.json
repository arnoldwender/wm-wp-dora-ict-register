{
    "name": "arnoldwender/wm-dora-ict-register",
    "description": "DORA ICT third-party register with concentration risk analysis.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "WMCyber\\DORA\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WMCyber\\DORA\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
